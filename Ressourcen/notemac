#!/bin/sh
# Öffnet Dateien in NoteMac++. Fehlende Dateien legt der Befehl leer an.
#   notemac datei.txt notizen.md
#   notemac            (nur NoteMac++ öffnen)
set -e

# Die Kennung stammt aus der Zeit, als NoteMac++ «Kladde» hiess. Sie bleibt, damit
# die Einstellungen erhalten bleiben.
KENNUNG=io.github.simon-baumhauer.kladde

if [ "$#" -eq 0 ]; then
  exec open -b "$KENNUNG"
fi

case "$1" in
  -h|--help)
    echo "Aufruf: notemac [datei ...]"
    echo "Öffnet die Dateien in NoteMac++; fehlende Dateien werden leer angelegt."
    exit 0
    ;;
esac

for datei in "$@"; do
  [ -e "$datei" ] || : > "$datei"
done
exec open -b "$KENNUNG" -- "$@"
