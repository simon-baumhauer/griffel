#!/bin/sh
# Öffnet Dateien in Kladde. Fehlende Dateien legt der Befehl leer an.
#   kladde datei.txt notizen.md
#   kladde            (nur Kladde öffnen)
set -e

if [ "$#" -eq 0 ]; then
  exec open -b io.github.simon-baumhauer.kladde
fi

case "$1" in
  -h|--help)
    echo "Aufruf: kladde [datei ...]"
    echo "Öffnet die Dateien in Kladde; fehlende Dateien werden leer angelegt."
    exit 0
    ;;
esac

for datei in "$@"; do
  [ -e "$datei" ] || : > "$datei"
done
exec open -b io.github.simon-baumhauer.kladde -- "$@"
